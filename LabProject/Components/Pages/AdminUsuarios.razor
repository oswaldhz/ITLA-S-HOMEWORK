@page "/admin/usuarios"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Administrar usuarios</PageTitle>

<h1>Administrar usuarios</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="card mb-4">
    <div class="card-header">Crear usuario</div>
    <div class="card-body">
        <EditForm Model="usuarioForm" OnValidSubmit="CrearUsuarioAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="nombre" class="form-label">Nombre</label>
                <InputText id="nombre" class="form-control" @bind-Value="usuarioForm.Nombre" />
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Correo</label>
                <InputText id="email" class="form-control" @bind-Value="usuarioForm.Email" type="email" />
            </div>

            <div class="mb-3">
                <label for="rol" class="form-label">Rol</label>
                <InputSelect id="rol" class="form-select" @bind-Value="usuarioForm.Rol">
                    <option value="">Seleccione un rol</option>
                    <option value="Admin">Admin</option>
                    <option value="Asistente">Asistente</option>
                    <option value="Estudiante">Estudiante</option>
                </InputSelect>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Contraseña</label>
                <InputText id="password" class="form-control" @bind-Value="usuarioForm.Password" type="password" />
            </div>

            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
                @(isSubmitting ? "Guardando..." : "Crear usuario")
            </button>
        </EditForm>
    </div>
</div>

<h2>Usuarios registrados</h2>

@if (isLoading)
{
    <p>Cargando usuarios...</p>
}
else if (usuarios.Count == 0)
{
    <p>No hay usuarios registrados.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in usuarios)
            {
                <tr>
                    <td>@usuario.Nombre</td>
                    <td>@usuario.Email</td>
                    <td>@usuario.Rol</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly SaveUsuarioRequest usuarioForm = new() { Rol = "Estudiante" };
    private readonly List<UsuarioDto> usuarios = new();
    private bool isLoading;
    private bool isSubmitting;
    private string? errorMessage;

    [Inject]
    private ApiClient ApiClient { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuariosAsync();
    }

    private async Task CargarUsuariosAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await ApiClient.GetAsync<List<UsuarioDto>>("api/Usuarios");
            usuarios.Clear();

            if (result is not null)
            {
                usuarios.AddRange(result);
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"No se pudieron cargar los usuarios: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CrearUsuarioAsync()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var creado = await ApiClient.PostAsync<SaveUsuarioRequest, UsuarioDto>("api/Usuarios", usuarioForm);
            if (creado is not null)
            {
                usuarios.Add(creado);
                usuarioForm.Nombre = string.Empty;
                usuarioForm.Email = string.Empty;
                usuarioForm.Rol = "Estudiante";
                usuarioForm.Password = string.Empty;
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"No se pudo crear el usuario: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
