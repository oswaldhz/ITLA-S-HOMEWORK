@page "/login"

<PageTitle>Login</PageTitle>

<h1>Iniciar sesión</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<EditForm Model="loginRequest" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label" for="email">Correo electrónico</label>
        <InputText id="email" class="form-control" @bind-Value="loginRequest.Email" type="email" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="password">Contraseña</label>
        <InputText id="password" class="form-control" @bind-Value="loginRequest.Password" type="password" />
    </div>

    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
        @(isSubmitting ? "Iniciando..." : "Iniciar sesión")
    </button>
</EditForm>

@code {
    private readonly LoginRequest loginRequest = new();
    private string? errorMessage;
    private bool isSubmitting;

    [Inject]
    private ApiClient ApiClient { get; set; } = default!;

    [Inject]
    private AuthState AuthState { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.EnsureInitializedAsync();

        if (AuthState.IsAuthenticated && AuthState.Session is not null)
        {
            NavigateToDashboard(AuthState.Session);
        }
    }

    private async Task HandleValidSubmit()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            var response = await ApiClient.LoginAsync(loginRequest);
            if (response is null)
            {
                errorMessage = "Credenciales inválidas. Verifique su correo y contraseña.";
                return;
            }

            await AuthState.SetSessionAsync(response);
            NavigateToDashboard(response);
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Error al iniciar sesión: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void NavigateToDashboard(AuthResponse session)
    {
        var target = string.Equals(session.User.Rol, "Admin", StringComparison.OrdinalIgnoreCase)
            ? "/admin/usuarios"
            : "/mis-reservas";

        NavigationManager.NavigateTo(target, forceLoad: true);
    }
}
